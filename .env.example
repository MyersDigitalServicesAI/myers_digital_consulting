# Myers Digital AIOS — Environment Variables
# Copy this to .env and fill in your values

# ─── CLAUDE API ───────────────────────────────────────────────────────────────
# Required. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── NOTION ───────────────────────────────────────────────────────────────────
# Required for memory/context layer. Get from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...

# Paste the ID from each database URL (the 32-char hex string)
# e.g., https://notion.so/myersdigital/abc123... → abc123...
NOTION_DB_BUSINESS_CONTEXT=
NOTION_DB_KPI_SNAPSHOTS=
NOTION_DB_DECISION_LOG=
NOTION_DB_SOP_LIBRARY=
NOTION_DB_MODULE_MEMORY=
NOTION_DB_AUTOMATION_LOG=
NOTION_DB_CLIENT_REGISTRY=
NOTION_DB_GHL_TRACKER=

# ─── ZAPIER WEBHOOKS ──────────────────────────────────────────────────────────
# Paste the webhook URL from each Zap's trigger step
# Client Delivery
ZAPIER_WEBHOOK_DEL_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DEL_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DEL_03=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DEL_04=https://hooks.zapier.com/hooks/catch/.../

# Sales
ZAPIER_WEBHOOK_SAL_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_SAL_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_SAL_03=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_SAL_04=https://hooks.zapier.com/hooks/catch/.../

# Finance
ZAPIER_WEBHOOK_FIN_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_FIN_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_FIN_03=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_FIN_04=https://hooks.zapier.com/hooks/catch/.../

# Marketing
ZAPIER_WEBHOOK_MKT_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_MKT_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_MKT_03=https://hooks.zapier.com/hooks/catch/.../

# Operations
ZAPIER_WEBHOOK_OPS_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_OPS_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_OPS_03=https://hooks.zapier.com/hooks/catch/.../

# Analytics
ZAPIER_WEBHOOK_DAT_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DAT_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DAT_03=https://hooks.zapier.com/hooks/catch/.../

# Notifications → Callan
ZAPIER_WEBHOOK_NOTIFY_SMS=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_NOTIFY_SLACK=https://hooks.zapier.com/hooks/catch/.../

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Set to "disabled" to prevent cron jobs from running (e.g., during dev/test)
AIOS_SCHEDULER=disabled
