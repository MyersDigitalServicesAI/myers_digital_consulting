# Myers Digital AIOS — Environment Variables
# Copy this to .env and fill in your values

# ─── CLAUDE API ───────────────────────────────────────────────────────────────
# Required. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── NOTION ───────────────────────────────────────────────────────────────────
# Required for memory/context layer. Get from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...

# Live database IDs — confirmed from Myers Digital AIOS workspace
# These are hardcoded as defaults in notion.ts; set here only to override
NOTION_DB_BUSINESS_CONTEXT=7786ce5b-3577-4da0-a3a6-f476c91e17c6
NOTION_DB_KPI_SNAPSHOTS=09aabe65-3a54-40fe-bc59-fae4cbebaaa2
NOTION_DB_DECISION_LOG=e0005065-252b-48f0-844f-532ea2686bf2
NOTION_DB_SOP_LIBRARY=73aad413-4d8c-491c-aa21-77d0966a3585
NOTION_DB_MODULE_MEMORY=def5c68a-6002-4225-9013-e38f94fc5fc9
NOTION_DB_AUTOMATION_LOG=44bab4bf-b1c7-44f4-b845-33064b8b5fd2
NOTION_DB_CONNECTOR_REGISTRY=a3b50335-3872-4893-9adb-1c882440411b

# ─── SLACK (Direct API — no Zapier webhook needed) ────────────────────────────
# Get Bot Token from: https://api.slack.com/apps → OAuth & Permissions
# Required scope: chat:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_NOTIFY_CHANNEL=#general   # Channel for Director alerts to Dustin

