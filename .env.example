# ─── GHL (GoHighLevel) DIRECT API ────────────────────────────────────────────
# Replaces Zapier stubs for CRM and Operations agents.
# Get Private Integration token: GHL → Settings → Integrations → Private Integrations
#
# GHL_API_KEY          Location-level token (contacts, opportunities, pipeline)
# GHL_AGENCY_API_KEY   Agency-level token (creating sub-accounts/locations)
#                      If your token has agency access, set both to the same value.
# GHL_LOCATION_ID      Your main GHL location ID (Settings → Business Info → Location ID)
# GHL_PIPELINE_ID      The pipeline ID to use for client tracking
#                      (Opportunities → Pipelines → click pipeline → ID in URL)
# GHL_SNAPSHOT_ID      Optional: snapshot applied to new sub-accounts on creation
GHL_API_KEY=
GHL_AGENCY_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_SNAPSHOT_ID=        # optional

# ─── SOCIAL PLATFORM DIRECT APIs (optional — Zapier works without these) ──────

# Meta (Facebook + Instagram)
# Get from: https://developers.facebook.com → Your App → Access Tokens
META_ACCESS_TOKEN=
META_PAGE_ID=               # Facebook Page ID (from Page About section)
META_IG_ACCOUNT_ID=         # Instagram Business Account ID
META_AD_ACCOUNT_ID=         # Ad Account ID (without "act_" prefix)

# LinkedIn
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=   # LinkedIn company page ID

# Google Ads
# Get from: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=     # 10-digit customer ID (no dashes)
GOOGLE_ADS_REFRESH_TOKEN=   # OAuth2 refresh token

# Twitter/X
# Get from: https://developer.twitter.com
TWITTER_BEARER_TOKEN=

# ─── SUPABASE (Client Portal) ─────────────────────────────────────────────────
# Project: aios-platform-prod  |  ID: biiusbjjuulgomzwtjzz
# Get keys from: https://supabase.com/dashboard/project/biiusbjjuulgomzwtjzz/settings/api
#
# VITE_ prefix makes these available in the browser bundle (safe — anon key is public)
VITE_SUPABASE_URL=https://biiusbjjuulgomzwtjzz.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only: service role key bypasses RLS — keep secret, never expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Used to authenticate admin portal endpoints (POST /api/portal/admin/provision, etc.)
# Set to a strong random string, e.g.: openssl rand -hex 32
PORTAL_ADMIN_SECRET=

# ─── STRIPE (Billing) ─────────────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_... in prod)
STRIPE_SECRET_KEY=

# Webhook signing secret. Create the endpoint at
# https://dashboard.stripe.com/webhooks pointing to <server-url>/webhooks/stripe
# with events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Set to "true" to enable Stripe Tax on checkout (requires Tax enabled in dashboard)
STRIPE_AUTOMATIC_TAX=false

# Optional price ID overrides (defaults are the live AIOS prices).
# Set these to test-mode price IDs in development.
# STRIPE_PRICE_STARTER_MONTH=price_...
# STRIPE_PRICE_STARTER_YEAR=price_...
# STRIPE_PRICE_GROWTH_MONTH=price_...
# STRIPE_PRICE_GROWTH_YEAR=price_...
# STRIPE_PRICE_FULL_STACK_MONTH=price_...
# STRIPE_PRICE_FULL_STACK_YEAR=price_...

# Public URL of the app (used in invite link generation)
APP_URL=https://myersdigitalconsulting.com

# ─── SERVER ───────────────────────────────────────────────────────────────────
# Shared secret for the agent-dispatching webhooks (/webhooks/* except Stripe).
# REQUIRED in production — without it the server refuses webhook traffic.
# Callers send it as an `x-aios-secret` header (or `?secret=` query param for
# services that can't set headers). Generate with: openssl rand -hex 32
AIOS_WEBHOOK_SECRET=

PORT=3000
NODE_ENV=development

# Set to "disabled" to prevent cron jobs from running (e.g., during dev/test)
AIOS_SCHEDULER=disabled

# ─── TRANSACTIONAL EMAIL (Resend) ─────────────────────────────────────────────
# Optional — without these, invite/dunning/SOPs-ready emails are skipped and
# the admin UI shows the invite link to copy manually instead.
# Get an API key at https://resend.com (verify your sending domain first).
RESEND_API_KEY=
# Must be on your verified Resend domain, e.g. "Myers Digital <hello@myersdigitalconsulting.com>"
EMAIL_FROM=

# ─── AGENT COST CONTROLS ──────────────────────────────────────────────────────
# Hard cap on a single agent run (USD). A runaway tool loop stops once its
# accumulated token cost crosses this. Default: 5
AIOS_MAX_RUN_COST_USD=5

# Daily (UTC) spend kill switch across ALL agents, computed from the
# agent_runs audit table. New runs are refused once today's recorded spend
# crosses this. Default: 50
AIOS_DAILY_BUDGET_USD=50

# Model for the Director agent. Default: claude-opus-4-8.
# Set to claude-sonnet-4-6 to cut Director cost ~40% per token.
# AIOS_DIRECTOR_MODEL=claude-sonnet-4-6
