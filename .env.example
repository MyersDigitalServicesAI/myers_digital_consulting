ZAPIER_WEBHOOK_FIN_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_FIN_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_FIN_03=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_FIN_04=https://hooks.zapier.com/hooks/catch/.../

# Marketing
ZAPIER_WEBHOOK_MKT_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_MKT_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_MKT_03=https://hooks.zapier.com/hooks/catch/.../

# Operations
ZAPIER_WEBHOOK_OPS_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_OPS_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_OPS_03=https://hooks.zapier.com/hooks/catch/.../

# Analytics
ZAPIER_WEBHOOK_DAT_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DAT_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_DAT_03=https://hooks.zapier.com/hooks/catch/.../

# Notifications → Dustin
ZAPIER_WEBHOOK_NOTIFY_SMS=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_NOTIFY_SLACK=https://hooks.zapier.com/hooks/catch/.../

# Social Media Publishing (via Zapier)
ZAPIER_WEBHOOK_SOC_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_SOC_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_SOC_03=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_SOC_04=https://hooks.zapier.com/hooks/catch/.../

# Paid Ads — Lead Routing (Meta/Google/LinkedIn → GHL)
ZAPIER_WEBHOOK_ADS_01=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_ADS_02=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_ADS_03=https://hooks.zapier.com/hooks/catch/.../
ZAPIER_WEBHOOK_ADS_04=https://hooks.zapier.com/hooks/catch/.../

# ─── SOCIAL PLATFORM DIRECT APIs (optional — Zapier works without these) ──────

# Meta (Facebook + Instagram)
# Get from: https://developers.facebook.com → Your App → Access Tokens
META_ACCESS_TOKEN=
META_PAGE_ID=               # Facebook Page ID (from Page About section)
META_IG_ACCOUNT_ID=         # Instagram Business Account ID
META_AD_ACCOUNT_ID=         # Ad Account ID (without "act_" prefix)

# LinkedIn
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=   # LinkedIn company page ID

# Google Ads
# Get from: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=     # 10-digit customer ID (no dashes)
GOOGLE_ADS_REFRESH_TOKEN=   # OAuth2 refresh token

# Twitter/X
# Get from: https://developer.twitter.com
TWITTER_BEARER_TOKEN=

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Set to "disabled" to prevent cron jobs from running (e.g., during dev/test)
AIOS_SCHEDULER=disabled
