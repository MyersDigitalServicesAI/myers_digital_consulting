      "status": "active",
      "criticality": "LOW"
    },
    "google_ads": {
      "purpose": "Paid advertising — Google Search + Display",
      "auth": "GOOGLE_ADS_DEVELOPER_TOKEN",
      "agent": "google-ads-manager",
      "status": "configured",
      "criticality": "LOW"
    },
    "railway": {
      "purpose": "Cloud hosting for AIOS server",
      "config": "railway.toml",
      "build_command": "pnpm build",
      "start_command": "node dist/server/index.js",
      "status": "active",
      "criticality": "CRITICAL"
    },
    "quickbooks": {
      "purpose": "Accounting and expense tracking",
      "integration": "Via Bookkeeping agent export (CSV) + Zapier",
      "agent": "bookkeeping",
      "status": "configured",
      "criticality": "LOW"
    },
    "docusign": {
      "purpose": "Contract signing for clients + contractors",
      "integration": "Via Zapier (HR-01, FIN-03)",
      "status": "configured",
      "criticality": "LOW"
    }
